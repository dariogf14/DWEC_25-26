<%- include('partials/header') %><section class="card"><h1>Dashboard for <%= user.username %></h1><p><a href="/portfolio/<%= user.username %>">Ver mi portafolio público</a></p></section><section class="card"><h2>Perfil</h2><form action="/dashboard/profile" method="POST" class="stack-form"><label>Email:<input type="email" name="email" value="<%= user.email %>" required></label><label>Foto de perfil:<input type="url" name="photo" value="<%= user.photo || '' %>" placeholder="https://..."></label><label>Bio:<textarea name="bio" rows="5"><%= user.bio || '' %></textarea></label><button type="submit">Guardar perfil</button></form></section><section class="card"><h2>Social Links</h2><form action="/dashboard/social-links" method="POST" class="inline-form"><input type="text" name="platform" placeholder="GitHub, LinkedIn..." required><input type="url" name="url" placeholder="https://..." required><button type="submit">Añadir enlace</button></form><% if (socialLinks.length === 0) { %><p>No hay enlaces sociales.</p><% } else { %><ul class="management-list"><% socialLinks.forEach(link => { %><li><span><strong><%= link.platform %>:</strong> <%= link.url %></span><a class="danger-link" href="/dashboard/social-links/delete/<%= link.id %>" onclick="return confirm('¿Eliminar este enlace?')">Eliminar</a></li><% }) %></ul><% } %></section><section class="card"><h2>Projects</h2><form action="/dashboard/projects" method="POST" class="stack-form"><label>Título:<input type="text" name="title" required></label><label>Descripción:<textarea name="description" rows="4" required></textarea></label><label>Repo URL:<input type="url" name="repo_url" placeholder="https://github.com/..."></label><label>Live URL:<input type="url" name="live_url" placeholder="https://..."></label><button type="submit">Añadir proyecto</button></form><% if (projects.length === 0) { %><p>No hay proyectos.</p><% } else { %><% projects.forEach(project => { %><article class="project"><h3><%= project.title %></h3><p><%= project.description %></p><a href="/dashboard/projects/edit/<%= project.id %>">Editar</a> | <a class="danger-link" href="/dashboard/projects/delete/<%= project.id %>" onclick="return confirm('¿Eliminar este proyecto?')">Eliminar</a></article><% }) %><% } %></section><%- include('partials/footer') %>
