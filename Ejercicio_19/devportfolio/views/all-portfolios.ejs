<%- include('partials/header') %><section class="card"><h1>All Portfolios</h1><% if (users.length === 0) { %><p>No hay portafolios disponibles.</p><% } else { %><div class="portfolio-grid"><% users.forEach(user => { %><article class="mini-card"><img class="avatar small" src="<%= user.photo || '/img/avatar.svg' %>" alt="<%= user.username %>"><h2><%= user.username %></h2><p><%= user.bio || 'Sin biografía todavía.' %></p><a href="/portfolio/<%= user.username %>">Ver portafolio</a></article><% }) %></div><% } %></section><%- include('partials/footer') %>
