<%- include('partials/header') %><section class="form-card wide"><h1>Edit Project</h1><form action="/dashboard/projects/edit/<%= project.id %>" method="POST" class="stack-form"><label>Título:<input type="text" name="title" value="<%= project.title %>" required></label><label>Descripción:<textarea name="description" rows="5" required><%= project.description %></textarea></label><label>Repo URL:<input type="url" name="repo_url" value="<%= project.repo_url || '' %>"></label><label>Live URL:<input type="url" name="live_url" value="<%= project.live_url || '' %>"></label><div class="actions"><button type="submit">Guardar cambios</button><a class="btn secondary" href="/dashboard">Cancelar</a></div></form></section><%- include('partials/footer') %>
