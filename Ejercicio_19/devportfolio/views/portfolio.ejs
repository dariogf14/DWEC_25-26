<%- include('partials/header') %><section class="card profile"><img class="avatar" src="<%= user.photo || '/img/avatar.svg' %>" alt="<%= user.username %>"><div><h1><%= user.username %></h1><p><strong>Email:</strong> <%= user.email %></p><p><strong>Bio:</strong> <%= user.bio || 'Sin biografía todavía.' %></p><% if (isOwner) { %><a class="btn" href="/dashboard">Gestionar mi Portafolio</a><% } %></div></section><section class="card"><h2>Social Links</h2><% if (socialLinks.length === 0) { %><p>No hay enlaces sociales.</p><% } else { %><ul><% socialLinks.forEach(link => { %><li><a href="<%= link.url %>" target="_blank"><%= link.platform %></a></li><% }) %></ul><% } %></section><section class="card"><h2>Projects</h2><% if (projects.length === 0) { %><p>No hay proyectos publicados.</p><% } else { %><% projects.forEach(project => { %><article class="project"><h3><%= project.title %></h3><p><%= project.description %></p><% if (project.repo_url) { %><a href="<%= project.repo_url %>" target="_blank">Repo</a><% } %><% if (project.live_url) { %><% if (project.repo_url) { %> | <% } %><a href="<%= project.live_url %>" target="_blank">Live Demo</a><% } %></article><% }) %><% } %></section><%- include('partials/footer') %>
