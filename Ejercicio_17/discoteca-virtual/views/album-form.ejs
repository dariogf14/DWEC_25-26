<%- include('partials/header') %>

<h1><%= album.id ? 'Editar Álbum' : 'Añadir Nuevo Álbum' %></h1>

<% if (error) { %>
  <div class="error-box"><%= error %></div>
<% } %>

<form class="form-card" action="/album/save" method="POST">
  <input type="hidden" name="id" value="<%= album.id || '' %>">

  <label>
    Título:
    <input type="text" name="titulo" value="<%= album.titulo || '' %>" required>
  </label>

  <label>
    Año:
    <input type="number" name="anio" value="<%= album.anio || '' %>" required>
  </label>

  <label>
    Artista:
    <select name="artistaId" required>
      <option value="">Selecciona un artista</option>
      <% artistas.forEach(artista => { %>
        <option value="<%= artista.id %>" <%= Number(album.artistaId) === artista.id ? 'selected' : '' %>>
          <%= artista.nombre %>
        </option>
      <% }) %>
    </select>
  </label>

  <label>
    URL de la Foto:
    <input type="url" name="foto" value="<%= album.foto || '' %>" placeholder="https://...">
  </label>

  <div class="preview-box">
    <p>Vista previa:</p>
    <img class="preview-img" src="<%= album.foto || '/img/placeholder.svg' %>" alt="Vista previa">
  </div>

  <div class="form-actions">
    <button class="btn" type="submit">Guardar</button>
    <a class="btn btn-secondary" href="/albumes">Cancelar</a>
  </div>
</form>

<%- include('partials/footer') %>
